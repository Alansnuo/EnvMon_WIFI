/**
 * esp8266.c
 * ESP8266 WiFi 模块驱动函数实现
 * @date 2026.09.23
 *
 * 基于 USART2 (DMA 环形接收 + 中断发送), 把 WiFi / MQTT 操作翻译成 AT 指令.
 * 顺序阻塞: 每个接口内部"发一条命令 → 等应答 → 再发下一条", 等的时候调
 * BSP_DelayMs 让出 CPU, 返回前调用者不会往下走.
 *
 * 分区: 对外接口(初始化 / WiFi / MQTT) → 内部实现(接收 / 拼命令 / 命令收发)
 */

/* --------------------------------- 头文件 --------------------------------- */
#include "esp8266.h"
#include "bsp_delay.h"
#include <string.h>
#include <stdio.h>

