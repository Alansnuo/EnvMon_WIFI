# ==================================================================
# EnvMon_WIFI .gitignore
# 原则: 只跟踪"源代码 + Keil 工程文件";
#       笔记 / 编译产物 / 本机配置 / 临时文件一律不入库.
# 注意: 本文件只对"未跟踪"文件生效; 已入库的文件需 git rm --cached 移出索引.
# ==================================================================

# ---------- 笔记(只留本地; 任何目录下的 .md 都不入库, 根目录 README 除外) ----------
*.md
!README.md
笔记/
详解/
整体架构/
整体架构笔记/
移植笔记*/

# ---------- MDK-Keil 编译产物 / 本机生成文件 ----------
MDK-ARM/project/
MDK-ARM/Objects/
MDK-ARM/Listings/
MDK-ARM/DebugConfig/
MDK-ARM/RTE/
MDK-ARM/.vscode/
*.o
*.d
*.crf
*.dep
*.axf
*.hex
*.bin
*.map
*.lst
*.iex
*.htm
*.uvguix.*
*.uvoptx
*.scvd
JLinkLog.txt

# ---------- 日志(VSCode 插件 / 构建日志) ----------
*.log
*.log.lock

# ---------- CMSIS 中本工程未使用的部分(DSP/Lib/NN) ----------
Drivers/CMSIS/DSP/
Drivers/CMSIS/Lib/
Drivers/CMSIS/NN/

# ---------- IDE 本机专属配置 ----------
.idea/

# ---------- 临时备份 / 语法自检工作区 ----------
*.bak
*.bak-*
_pre_reset_backup/
_syntax_check/
